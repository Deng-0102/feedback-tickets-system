# 复制为 .env 后按本机环境修改。不要提交真实密钥。
APP_ENV=development
# 留空时，本地开发每次启动使用新的签名密钥。共享环境请显式配置。
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=120

# 默认 SQLite 可直接开发；部署到 MySQL 时替换连接串并安装对应驱动。
DATABASE_URL=sqlite+pysqlite:///./feedback_ticket.db

# 多个地址使用英文逗号分隔。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== 3 号：智能分析模块（不填密钥时智能分析返回 503，工单主流程不受影响） =====
# deepseek=调用真实模型；mock=离线演示（不调用模型，结果标记为 mock-demo）；off=关闭
ANALYSIS_PROVIDER=deepseek
# 在模型平台申请后填入，本文件只保留空值，真实密钥写在 .env 且不得提交
ANALYSIS_API_KEY=
# OpenAI 兼容地址；换通义、Kimi、智谱等平台时同时改 BASE_URL 与 MODEL
ANALYSIS_BASE_URL=https://api.deepseek.com/v1
ANALYSIS_MODEL=deepseek-chat
ANALYSIS_TIMEOUT_SECONDS=30
ANALYSIS_MAX_RETRIES=1
ANALYSIS_TEMPERATURE=0.2


